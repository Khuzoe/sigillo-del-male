{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sigillo-api",
  "main": "src/index.js",
  "compatibility_date": "2026-05-15",
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "SIGILLO_KV",
      "id": "7c63ace205664e65bd59db105d74708a"
    }
  ],
  "d1_databases": [
    {
      "binding": "POLL_DB",
      "database_name": "khuzoe-wiki",
      "database_id": "7cbdeb91-6194-4212-a89b-eda4fce4d58d",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "khuzoe-wiki"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CALENDAR_STORE",
        "class_name": "CalendarStore"
      },
      {
        "name": "FOUNDRY_SYNC_HUB",
        "class_name": "FoundrySyncHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "foundry-sync-hub-v1",
      "new_sqlite_classes": [
        "FoundrySyncHub"
      ]
    },
    {
      "tag": "calendar-store-v1",
      "new_sqlite_classes": ["CalendarStore"]
    }
  ],
  "vars": {
    // D1 enabled for polls and skill-tree progress in all configured campaigns.
    "POLL_D1_CAMPAIGNS": "cripta-di-sangue,mago-folle,oltre-il-velo",
    "POLL_WRITES_PAUSED_CAMPAIGNS": "",
    "SKILL_TREE_D1_CAMPAIGNS": "cripta-di-sangue,mago-folle,oltre-il-velo",
    "SKILL_TREE_WRITES_PAUSED_CAMPAIGNS": "",
    "DISCORD_CLIENT_ID": "1475822167890595841",
    "DISCORD_REDIRECT_URI": "https://sigillo-api.khuzoe.workers.dev/auth/discord/callback",
    "FE_URL": "https://khuzoe.github.io/sigillo-del-male/",
    "DISCORD_SHARE_CHANNEL_CRIPTA_DI_SANGUE": "1362343971866677428",
    "DISCORD_SHARE_CHANNEL_MAGO_FOLLE_NPC": "906264443107803186",
    "DISCORD_SHARE_CHANNEL_MAGO_FOLLE_ITEM": "894715558883369021",
    "DISCORD_SHARE_CHANNEL_OLTRE_IL_VELO_NPC": "1024362598390583356",
    "GLOBAL_ADMIN_ACCOUNT_IDS": "admin",
    "NOTES_ADMIN_DISCORD_IDS": "142960432389423104",
    "CAMPAIGN_EDITOR_ACCOUNT_IDS": "oltre-il-velo:dona;mago-folle:sommo",
    "SESSION_START_NOTIFY_CAMPAIGNS": "cripta-di-sangue,mago-folle,oltre-il-velo",
    "DISCORD_BOT_NOTIFY_CAMPAIGNS": "cripta-di-sangue,mago-folle,oltre-il-velo",
    "DISCORD_BOT_POLL_REMINDER_DAYS": "2",
    "DISCORD_BOT_DAY_REMINDER_HOUR": "10"
  },
  "secrets": {
    "required": [
      "DEVICE_LOGIN_CODES_SECRET",
      "GLOBAL_ADMIN_DEVICE_CODE",
      "INVENTORY_SYNC_SECRET",
      "DISCORD_CLIENT_SECRET",
      "JWT_SECRET",
      "SESSION_DISCORD_WEBHOOKS",
      "DISCORD_BOT_TOKEN"
    ]
  }
}
