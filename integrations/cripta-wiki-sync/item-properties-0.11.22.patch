+/* The same engraving and paper colors are used on the wiki and in Foundry sheets. */
+.cripta-catalog-properties {
+    display: grid;
+    grid-template-columns: minmax(0, 1fr);
+    gap: .85rem;
+}
+.cripta-catalog-property {
+    --paper: light-dark(#fff8e9, #302a26);
+    --ink: light-dark(#352b26, #f3e9da);
+    --accent: light-dark(#765331, #dfbc8d);
+    box-sizing: border-box;
+    min-width: 0;
+    padding: .95em 1.2em 1.05em;
+    border: 1px solid color-mix(in srgb, var(--accent) 26%, var(--paper));
+    border-inline-start: 4px double var(--accent);
+    border-radius: 1px;
+    background: var(--paper);
+    color: var(--ink);
+    box-shadow: 0 2px 6px #1d110b16;
+    font: 1em/1.55 Georgia, serif;
+    overflow-wrap: anywhere;
+}
+.theme-dark .cripta-catalog-property { color-scheme: dark; }
+.theme-light .cripta-catalog-property { color-scheme: light; }
+.cripta-catalog-property--genial {
+    --paper: light-dark(#fcf3dc, #332c22);
+    --accent: light-dark(#795314, #edc379);
+}
+.cripta-catalog-property--negative {
+    --paper: light-dark(#fcf0ea, #352827);
+    --accent: light-dark(#873848, #efacb1);
+}
+.cripta-catalog-property--genial::before,
+.cripta-catalog-property--negative::before {
+    display: block;
+    margin-block-end: .4em;
+    color: var(--accent);
+    font: 700 .7em/1.4 system-ui, sans-serif;
+    letter-spacing: .11em;
+    text-transform: uppercase;
+}
+/* Keep these legends outside the description that Foundry imports back into the wiki. */
+.cripta-catalog-property--genial::before { content: "✦  Geniale"; }
+.cripta-catalog-property--negative::before { content: "☾  Negativa"; }
+.cripta-catalog-properties section.cripta-catalog-property > h3 {
+    display: grid;
+    gap: .2em;
+    margin: 0 0 .48em;
+    padding: 0 0 .36em;
+    border: 0;
+    border-bottom: 1px solid color-mix(in srgb, var(--accent) 46%, var(--paper));
+    color: var(--accent);
+    font: 500 1.4em/1.15 Georgia, serif;
+    text-transform: none;
+    text-shadow: none;
+    letter-spacing: normal;
+}
+.cripta-catalog-property > h3 > span:empty { display: none; }
+.cripta-catalog-property-charges {
+    color: var(--accent);
+    font: italic .68em/1.4 Georgia, serif;
+}
+.cripta-catalog-property-charges[data-unit]::after { content: " " attr(data-unit); }
+.cripta-catalog-property p { margin: 0; color: var(--ink); line-height: 1.55; }
+.cripta-catalog-property p + p { margin-top: .5em; }
+.cripta-catalog-property :is(em, strong) { color: inherit; }
+:is(.cripta-catalog-property, .cripta-catalog-summary, .cripta-catalog-notes, .item-formatted-text) :is(ul, ol) {
+    margin: .4em 0;
+    padding-inline-start: 1.6em;
+}
+:is(.cripta-catalog-property, .cripta-catalog-summary, .cripta-catalog-notes, .item-formatted-text) ul { list-style: disc outside; }
+:is(.cripta-catalog-property, .cripta-catalog-summary, .cripta-catalog-notes, .item-formatted-text) ol { list-style: decimal outside; }
+.item-formatted-text p { margin: 0; }
+.item-formatted-text p + p { margin-top: .5em; }
 
